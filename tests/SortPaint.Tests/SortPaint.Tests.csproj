<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>SortPaint.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The rules in src/Core have no Godot dependency, so they compile straight into the
       test assembly. No reference to the game project, and so no GodotSharp needed here. -->
  <ItemGroup>
    <Compile Include="../../src/Core/**/*.cs" LinkBase="Core" />
  </ItemGroup>

  <!-- The server's copy of the handle word lists and the handle cases both sides must agree on,
       so HandleWordsTests can hold them up against the game's own check without walking the tree
       looking for the repository root. -->
  <ItemGroup>
    <Content Include="../../worker/words.json" Link="words.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../worker/handle-cases.json" Link="handle-cases.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit" Version="2.8.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.1" />
  </ItemGroup>

</Project>
