<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Browser (wasm) host: your C# code hosts the Godot engine in the browser.

      Publish:  dotnet publish SortPaint.web   (from the project root;
                the root global.json pins a wasm-capable SDK. Defaults to
                Release via Directory.Build.props; pass -c Debug to override.)
      Output:   AppBundle/ - serve with any static file server.

      Requires the wasm-tools workload:  dotnet workload install wasm-tools
      The 2dog.browser-wasm package statically links the Godot engine into
      dotnet.native.wasm during publish and exports the Godot project's
      content as godot.pck (using the desktop editor packages on this machine).
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- Keep host namespaces uniform with the desktop host (whose
             '.2dog' assembly name is not a valid namespace). -->
        <RootNamespace>SortPaint.Web</RootNamespace>
        <!-- Skip dotnet.native.js.symbols, a 19 MB wasm-function-number to name
             map that only symbolicates stack traces. The wasm SDK defaults this
             on for a plain browser-wasm app, and every asset it emits is listed
             in dotnet.boot.js and fetched at boot, so the file cannot simply be
             deleted from the bundle afterwards: a 404 rejects
             mono_download_assets and the engine never starts. Turning it off at
             the source keeps it out of the manifest too. Traces from a release
             build stay unsymbolicated either way. -->
        <WasmEmitSymbolMap>false</WasmEmitSymbolMap>
    </PropertyGroup>
    <!-- Godot project location: the parent directory (hosts are nested inside
         the Godot project, hidden from the Godot editor by their .gdignore) -->
    <PropertyGroup>
        <GodotProjectDir>..</GodotProjectDir>
        <TwoDogRemoveDuplicateGodotAnalyzers>true</TwoDogRemoveDuplicateGodotAnalyzers>
    </PropertyGroup>

    <ItemGroup>
        <!-- TwoDogWebBoot.cs is compiled by the GAME project (see the root
             csproj's Compile Include), not by this host. -->
        <Compile Remove="TwoDogWebBoot.cs"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="2dog.engine" Version="4.7.1.68"/>
        <PackageReference Include="2dog.browser-wasm" Version="[4.7.1.35]"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../SortPaint.csproj"/>
    </ItemGroup>

    <!-- Root the game assembly: scripts are resolved by reflection. Add a
         TrimmerRootAssembly for any NuGet package your game code reaches via
         reflection (e.g. an ECS or serializer library). -->
    <ItemGroup>
        <TrimmerRootAssembly Include="SortPaint"/>
        <TrimmerRootAssembly Include="$(TargetName)"/>
    </ItemGroup>

    <Target Name="DeepClean" AfterTargets="Clean">
        <RemoveDir Directories="AppBundle"/>
    </Target>
</Project>
