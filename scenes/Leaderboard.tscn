[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/LeaderboardView.cs" id="1_board"]
[ext_resource type="PackedScene" path="res://scenes/LeaderboardRow.tscn" id="2_row"]

[node name="Leaderboard" type="VBoxContainer" node_paths=PackedStringArray("HeaderLabel", "Rows", "StatusLabel")]
custom_minimum_size = Vector2(260, 0)
offset_right = 260.0
offset_bottom = 120.0
theme_override_constants/separation = 6
script = ExtResource("1_board")
RowScene = ExtResource("2_row")
HeaderLabel = NodePath("Header")
Rows = NodePath("Rows")
StatusLabel = NodePath("Status")
WaitingText = "Checking the board..."
EmptyText = "Nobody has painted this one yet."

[node name="Header" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"Readout"
theme_override_font_sizes/font_size = 18
text = "Fewest moves"
horizontal_alignment = 1

[node name="Rows" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 2

[node name="Status" type="Label" parent="."]
layout_mode = 2
theme_type_variation = &"Muted"
theme_override_font_sizes/font_size = 16
text = "Checking the board..."
horizontal_alignment = 1
autowrap_mode = 2
